# Fluxora backend — environment configuration (PLACEHOLDERS ONLY)
# Copy to `.env` and adjust. Never commit a real `.env`.

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# --- CORS ------------------------------------------------------------------
# Comma-separated explicit origins. Never use "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model artifacts -------------------------------------------------------
# Directory containing:
#   anomaly_model.joblib, forecast_model.joblib, model_config.json,
#   forecast_metrics.json  (exported from the Colab training notebook)
# Default: <repo>/backend/artifacts
MODEL_ARTIFACTS_DIR=

# --- Request limits --------------------------------------------------------
MAX_READINGS_PER_REQUEST=50000
MAX_REQUEST_BYTES=10485760

# --- Carbon emission factor ------------------------------------------------
# Fluxora ships NO default emission factor. The /carbon/summary endpoint
# returns 422 until these are set with a documented, sourced factor.
# CARBON_EMISSION_FACTOR is kg CO2 per kWh (positive number).
CARBON_EMISSION_FACTOR=
CARBON_FACTOR_SOURCE=
CARBON_FACTOR_REGION=
CARBON_FACTOR_YEAR=
# Must be kg_CO2_per_kwh — unit conversion is never performed silently.
CARBON_FACTOR_UNITS=kg_CO2_per_kwh
CARBON_FACTOR_EFFECTIVE_DATE=
